-- PostgreSQL version
-- Create the database manually if needed:
-- CREATE DATABASE opt_db;
-- Then connect to it:
-- \c opt_db

DROP TABLE IF EXISTS opt_orders;
DROP TABLE IF EXISTS opt_products;
DROP TABLE IF EXISTS opt_clients;

CREATE TABLE IF NOT EXISTS opt_clients (
    id UUID PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    surname VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    address TEXT NOT NULL,
    status VARCHAR(20) NOT NULL CHECK (status IN ('active', 'inactive'))
);

CREATE TABLE IF NOT EXISTS opt_products (
    product_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    product_name VARCHAR(255) NOT NULL,
    product_category VARCHAR(50) NOT NULL CHECK (
        product_category IN ('Category1', 'Category2', 'Category3', 'Category4', 'Category5')
    ),
    description TEXT
);

CREATE TABLE IF NOT EXISTS opt_orders (
    order_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    order_date DATE NOT NULL,
    client_id UUID,
    product_id INTEGER,
    CONSTRAINT fk_opt_orders_client
        FOREIGN KEY (client_id) REFERENCES opt_clients(id),
    CONSTRAINT fk_opt_orders_product
        FOREIGN KEY (product_id) REFERENCES opt_products(product_id)
);

 -- не оптимізована:

EXPLAIN ANALYZE
SELECT
    (
        SELECT CONCAT(name, ' ', surname, ': ', cnt, ' orders')
        FROM (
            -- рахую замовлення кожного клієнта (фільтр за 24 рік)
            SELECT c.name, c.surname, COUNT(*) AS cnt
            FROM opt_orders o
            JOIN opt_clients c ON o.client_id = c.id
            JOIN opt_products p ON o.product_id = p.product_id
            WHERE p.product_category = 'Category1'
              AND o.order_date BETWEEN DATE '2024-01-01' AND DATE '2024-12-31'
            GROUP BY c.id, c.name, c.surname
        ) AS sub1
        WHERE cnt = (
            -- беремо з мінімальною кількістю
            SELECT MIN(cnt)
            FROM (
                SELECT COUNT(*) AS cnt
                FROM opt_orders o
                JOIN opt_clients c ON o.client_id = c.id
                JOIN opt_products p ON o.product_id = p.product_id
                WHERE p.product_category = 'Category1'
                  AND o.order_date BETWEEN DATE '2024-01-01' AND DATE '2024-12-31'
                GROUP BY c.id
            ) AS sub2
        )
        -- обраємо одного такого
        LIMIT 1
    ) AS min_buyer,

    (
        SELECT CONCAT(name, ' ', surname, ': ', cnt, ' orders')
        FROM (
            -- рахую знову те саме, тільки рахуємо з максимальною
            SELECT c.name, c.surname, COUNT(*) AS cnt
            FROM opt_orders o
            JOIN opt_clients c ON o.client_id = c.id
            JOIN opt_products p ON o.product_id = p.product_id
            WHERE p.product_category = 'Category1'
              AND o.order_date BETWEEN DATE '2024-01-01' AND DATE '2024-12-31'
            GROUP BY c.id, c.name, c.surname
        ) AS sub3
        WHERE cnt = (
            SELECT MAX(cnt)
            FROM (
                SELECT COUNT(*) AS cnt
                FROM opt_orders o
                JOIN opt_clients c ON o.client_id = c.id
                JOIN opt_products p ON o.product_id = p.product_id
                WHERE p.product_category = 'Category1'
                  AND o.order_date BETWEEN DATE '2024-01-01' AND DATE '2024-12-31'
                GROUP BY c.id
            ) AS sub4
        )
        LIMIT 1
    ) AS max_buyer;

--стварення індексів

CREATE INDEX IF NOT EXISTS idx_opt_orders_date ON opt_orders(order_date);
CREATE INDEX IF NOT EXISTS idx_opt_orders_client ON opt_orders(client_id);
CREATE INDEX IF NOT EXISTS idx_opt_orders_product ON opt_orders(product_id);
CREATE INDEX IF NOT EXISTS idx_opt_products_category ON opt_products(product_category);

-- "вимикає" індекси (ну буквально)
SET enable_indexscan = off;

--оптимізований код:

EXPLAIN ANALYZE
WITH filtered_orders AS (
    -- використовую СТЕ, щоб рахувати замовлення клієнтів
    SELECT c.id, c.name, c.surname, o.order_id
    FROM opt_orders o
    JOIN opt_clients c ON o.client_id = c.id
    JOIN opt_products p ON o.product_id = p.product_id
    -- індекс не проходить усі мільйон міілардів рядочків, а знаходить по індексу
    WHERE p.product_category = 'Category1'
      AND o.order_date BETWEEN DATE '2024-01-01' AND DATE '2024-12-31'
),
client_counts AS (
    SELECT name, surname, COUNT(*) AS cnt
    -- рахуємо через вже СТЕ
    FROM filtered_orders
    GROUP BY id, name, surname
),
    -- фільтрація, щоб знайти максимум та мінімум найшвидше
ranked_clients AS (
    SELECT name, surname, cnt,
           ROW_NUMBER() OVER (ORDER BY cnt ASC, name ASC) AS min_rn,
           ROW_NUMBER() OVER (ORDER BY cnt DESC, name ASC) AS max_rn
    FROM client_counts
)
SELECT
    MAX(CONCAT(name, ' ', surname, ': ', cnt, ' orders')) FILTER (WHERE min_rn = 1) AS min_buyer,
    MAX(CONCAT(name, ' ', surname, ': ', cnt, ' orders')) FILTER (WHERE max_rn = 1) AS max_buyer
FROM ranked_clients;

-- і щоб активувати їх назад
SET enable_indexscan = on;
